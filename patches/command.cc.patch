Backport: ]USERCMD rejects the lambda line that )DUMP itself writes.

In apl-2.0, )DUMP and )DUMPV record an installed lambda user command as

    ]USERCMD ]tcmd {⍺,'; ',⍵} 1

i.e. with an explicit trailing mode. But 2.0's ]USERCMD parser concatenates
every token after the command name and requires the final character to be },
so its own dumped form ends in "1" and is rejected with BAD COMMAND. A dumped
workspace therefore cannot restore its user commands.

Already fixed upstream (svn trunk, Command.cc): the lambda is collected until
the curly braces balance, and a token after the closing } is parsed as the
explicit mode — the trunk comment cites "]USERCMD ]f {⍵+1} 0" as the intended
form. This patch is that trunk logic applied verbatim to the released 2.0
tarball.

--- apl-2.0/src/Command.cc
+++ apl-2.0/src/Command.cc
@@ -1961,21 +1961,36 @@
    if (apl_fun.front() == '{')
       {
          // looks like the user command is a lambda function.
+         // Collect space-separated tokens until curly braces balance; any
+         // token after the closing } is an explicit mode (e.g. ]USERCMD ]f
+         // {⍵+1} 0).
          UCS_string result;
-         // lambdas could contain spaces, collect all arguments in one string
+         int depth = 0;
+         ShapeItem lambda_end_idx = -1;
          for (ShapeItem i = 1; i < args.ssize(); ++i)
             {
+               for (ShapeItem k = 0; k < args[i].ssize(); ++k)
+                  {
+                    const Unicode uni = args[i][k];
+                    if      (uni == UNI_L_CURLY)   ++depth;
+                    else if (uni == UNI_R_CURLY)   --depth;
+                  }
                result << args[i];
+               if (depth == 0)   { lambda_end_idx = i;   break; }
             }
-         // check if lamda-function closed properly
-         if (result.back() == '}')
+         // check if lambda-function closed properly
+         if (depth == 0 && result.back() == UNI_R_CURLY)
             {
                is_lambda = true;
                apl_fun = result;
-               // determine the mode: if both alpha and omega present then
-               // assume dyadic, otherwise monadic usage
-               mode = (apl_fun.contains(UNI_OMEGA) &&
-                       apl_fun.contains(UNI_ALPHA)) ? 1 : 0;
+               // explicit mode may follow the closing }
+               if (lambda_end_idx + 1 < args.ssize())
+                  mode = args[lambda_end_idx + 1].atoi();
+               else
+                  // determine the mode: if both alpha and omega present then
+                  // assume dyadic, otherwise monadic usage
+                  mode = (apl_fun.contains(UNI_OMEGA) &&
+                          apl_fun.contains(UNI_ALPHA)) ? 1 : 0;
             }
          else
             {
