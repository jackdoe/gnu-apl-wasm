+++ apl-svn/src/libapl.cc
@@ -353,7 +353,7 @@
    if (new_value->is_simple_scalar())   // e.g. ⊂5 is 5
       {
         Cell cache;
-        cell->init(new_value->get_cfirst(cache), *val, LOC);
+        new_value->get_cfirst(cache).init_other(cell, *val, LOC);
       }
    else if (new_value->is_scalar())     // e.g. ⊂⊂5 is ⊂5
       {
@@ -565,10 +565,21 @@
 
